# Required
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# Optional: restrict server/channel access. DMs from owner always work.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Claude Code. If omitted, uses `claude` from PATH and inherits your existing
# ANTHROPIC_BASE_URL / ANTHROPIC_MODEL / CLAUDE_CODE_EFFORT_LEVEL environment.
CLAUDE_COMMAND=claude
DEFAULT_CWD=D:\\deepseeek

# Local approval service
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=37911
APPROVAL_TIMEOUT_MS=540000

# Policy: speed-first but still gate risky actions.
AUTO_ALLOW_WORKSPACE_WRITES=true
AUTO_ALLOW_TEST_COMMANDS=true
