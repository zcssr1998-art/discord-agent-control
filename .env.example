# Required
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# Optional: restrict server/channel access. DMs from owner always work.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Discord network.
# Node ignores the Windows system proxy, so if discord.com is only reachable
# through Clash/V2Ray in system-proxy mode the bot cannot log in until this is
# set. Leave it unset to auto-detect the Windows system proxy (recommended).
#   DISCORD_PROXY=http://127.0.0.1:7897   # your proxy
#   DISCORD_PROXY=off                     # force a direct connection
DISCORD_PROXY=

# --- agent executor ---------------------------------------------------------
# `workbuddy` resolves the bundled WorkBuddy agent CLI (a Claude Code compatible
# shell) automatically. Set an explicit path to use another shell, e.g.
# `claude` for the Anthropic Claude Code CLI.
CLAUDE_COMMAND=workbuddy
# Override the CLI location if it is not in a standard place:
#   WORKBUDDY_CLI=D:\WorkBuddy\WorkBuddyAI\resources\app.asar.unpacked\cli\dist\codebuddy.js
DEFAULT_CWD=D:\\deepseeek

# --- backend ----------------------------------------------------------------
# The bridge refuses to run on anything but this backend unless paid fallback is
# explicitly enabled, and it reports the backend in the startup log and !status.
AGENT_BACKEND=workbuddy-free-dsf
# true only if you deliberately want metered API credentials to be usable.
ALLOW_PAID_FALLBACK=false

# --- runaway protection -----------------------------------------------------
# Hard wall-clock cap on one task; hitting it kills the agent process.
TASK_TIMEOUT_MS=900000
# If the agent produces no event at all for this long, the status message is
# repainted with "仍在等待 PowerShell / Agent …". This never calls the model, so a
# silently stuck tool call is visible on the phone without spending tokens.
STALL_NOTICE_MS=30000
# Stop accepting new work after this many consecutive failures / restarts.
# `!reset` clears both counters.
MAX_CONSECUTIVE_FAILURES=3
MAX_PROCESS_RESTARTS=5

# --- local approval service (loopback only) ---------------------------------
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=37911
APPROVAL_TIMEOUT_MS=540000

# Policy: speed-first but still gate risky actions.
AUTO_ALLOW_WORKSPACE_WRITES=true
AUTO_ALLOW_TEST_COMMANDS=true

# --- discord noise control --------------------------------------------------
# --include-partial-messages is mostly thinking-token noise, so it is off.
CLAUDE_PARTIAL_MESSAGES=false
# Minimum gap between edits of the single live status message (ms).
PROGRESS_THROTTLE_MS=1500
# DM the owner once when the bridge comes online.
NOTIFY_ON_START=true

# Full stream-json transcript location. Defaults to <repo>/logs (git-ignored).
# LOG_DIR=
