# Required
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# Optional: restrict server/channel access. DMs from owner always work.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Discord network.
# Node ignores the Windows system proxy, so if discord.com is only reachable
# through Clash/V2Ray in system-proxy mode the bot cannot log in until this is
# set. Leave it unset to auto-detect the Windows system proxy (recommended).
#   DISCORD_PROXY=http://127.0.0.1:7897   # your proxy
#   DISCORD_PROXY=off                     # force a direct connection
DISCORD_PROXY=

# --- agent executor ---------------------------------------------------------
# `workbuddy` resolves the bundled WorkBuddy agent CLI (a Claude Code compatible
# shell) automatically. Set an explicit path to use another shell, e.g.
# `claude` for the Anthropic Claude Code CLI.
CLAUDE_COMMAND=workbuddy
# Override the CLI location if it is not in a standard place:
#   WORKBUDDY_CLI=D:\WorkBuddy\WorkBuddyAI\resources\app.asar.unpacked\cli\dist\codebuddy.js
DEFAULT_CWD=D:\\deepseeek

# --- backend ----------------------------------------------------------------
# The bridge refuses to run on anything but this backend unless paid fallback is
# explicitly enabled, and it reports the backend in the startup log and !status.
AGENT_BACKEND=workbuddy-free-dsf
# true only if you deliberately want metered API credentials to be usable.
ALLOW_PAID_FALLBACK=false

# --- runaway protection -----------------------------------------------------
# NO default hard wall-clock cap on a Work task. 0 (or unset) = unlimited: a
# healthy Agent runs until it finishes, you Stop it, the process exits/fails, or
# you set an explicit positive operator limit below. Duration alone never kills a
# live task. Set a positive value only for special/test deployments.
TASK_TIMEOUT_MS=0
# Startup backend preflight timeout (bounded independently of Work duration).
BACKEND_PROBE_TIMEOUT_MS=180000
# If the agent produces no event at all for this long, the status message is
# repainted with "仍在等待 PowerShell / Agent …". This never calls the model, so a
# silently stuck tool call is visible on the phone without spending tokens.
STALL_NOTICE_MS=30000
# Stop accepting new work after this many consecutive failures / restarts.
# `!reset` clears both counters.
MAX_CONSECUTIVE_FAILURES=3
MAX_PROCESS_RESTARTS=5

# --- local approval service (loopback only) ---------------------------------
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=37911
APPROVAL_TIMEOUT_MS=540000
# Keep the user-level agent hook (~/.claude, ~/.codebuddy) pointed at this
# checkout on every start; a stale hook path causes HTTP 401 fail-closed.
# Set to 0 to manage the hook manually with scripts\install-global-hook.ps1.
DISCORD_AUTO_HOOK=1

# Policy: speed-first but still gate risky actions.
AUTO_ALLOW_WORKSPACE_WRITES=true
AUTO_ALLOW_TEST_COMMANDS=true

# --- discord noise control --------------------------------------------------
# --include-partial-messages is mostly thinking-token noise, so it is off.
CLAUDE_PARTIAL_MESSAGES=false
# Minimum gap between edits of the single live status message (ms).
PROGRESS_THROTTLE_MS=1500
# DM the owner once when the bridge comes online.
NOTIFY_ON_START=true

# Full stream-json transcript location. Defaults to <repo>/logs (git-ignored).
# LOG_DIR=

# --- native Discord application commands (P2.1) ------------------------------
# Register /panel /work /model /settings /permission /status /doctor /stop /new
# /compact /help /update idempotently at startup. Set to 0 to disable.
DISCORD_AUTO_REGISTER_COMMANDS=true
# Optional guild-scoped registration for instant propagation during development.
# Leave unset for global registration; never commit a real guild id.
# DISCORD_COMMANDS_GUILD_ID=
# Max pending `追加需求` follow-ups per active Work chain.
MAX_WORK_FOLLOWUPS=10

# --- safe self-update (P2.2.6) ------------------------------------------------
# Jarvis keeps the live Windows checkout on a configured trusted Git branch:
# it fast-forwards a clean checkout after verifying the candidate in a throwaway
# worktree, then asks the existing Supervisor to restart (never hot-swaps and
# never kills active Work). Dirty/diverged checkouts are BLOCKED, not reset.
# Production target after the P2 release merge is origin/main.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_INTERVAL_MS=300000

# --- model gateway (LiteLLM) -------------------------------------------------
# LiteLLM is the primary standard model gateway (installed by
# scripts\install-litellm.ps1, started by scripts\start-litellm.ps1). Jarvis
# talks to it as one OpenAI-compatible endpoint on 127.0.0.1.
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# Optional. If unset, a local master key is generated under data\litellm\ and
# shared with Jarvis; the gateway never listens on a public interface.
# LITELLM_MASTER_KEY=
# OpenCode Go key for the chat-fast alias. If unset, the local OpenCode auth
# store is used. Never commit a real key.
# OPENCODE_GO_API_KEY=
# Mapped to the manual chat-smart alias only; not part of the AUTO chain.
# DEEPSEEK_API_KEY=

# --- chat (direct model API) -------------------------------------------------
# AUTO never spends on METERED/unknown billing unless this is enabled.
ALLOW_METERED_CHAT_FALLBACK=false
# Client-side wall-clock cap on one direct Chat request.
#   0 = unlimited / no Jarvis client-side timeout (default)
#   positive value = explicit operator timeout in milliseconds
# Provider/network/HTTP failures still surface normally at any value.
CHAT_TIMEOUT_MS=0

# Image turns: AUTO uses an explicit vision route here, else a LiteLLM `vision`
# alias, else a credentialed provider's cached `*vision*` model. Without any of
# those, an AUTO image turn fails clearly instead of being sent to a text-only
# model. Manual Chat pins keep their own model and never silently switch.
# CHAT_VISION_PROVIDER_ID=opencode-go
# CHAT_VISION_MODEL=deepseek-v4-flash-vision-exp
