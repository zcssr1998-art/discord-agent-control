{
  "name": "discord-agent-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord remote control plane for a local Claude Code agent, with phone approval gates.",
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "smoke:local": "node scripts/local-e2e.mjs",
    "smoke:discord": "node scripts/discord-e2e.mjs",
    "smoke:p1": "node scripts/p1-e2e.mjs",
    "smoke:p2": "node scripts/p2-e2e.mjs",
    "smoke:p22": "node scripts/p22-e2e.mjs",
    "smoke:p222": "node scripts/p222-chat-selection-e2e.mjs",
    "smoke:p22-insert": "node scripts/p22-live-insert-e2e.mjs",
    "smoke:p22-model": "node scripts/p22-model-restart-e2e.mjs",
    "smoke:p22-workspace": "node scripts/p22-workspace-e2e.mjs",
    "smoke:owner-settings": "node scripts/owner-settings-reset-e2e.mjs",
    "smoke:p223-full": "node scripts/p223-full-work-e2e.mjs",
    "smoke:p224-lifecycle": "node scripts/p224-lifecycle-e2e.mjs",
    "smoke:p225-limits": "node scripts/p225-limits-smoke.mjs",
    "smoke:p226-update": "node scripts/p226-update-smoke.mjs",
    "doctor:commands": "node scripts/command-schema-doctor.mjs",
    "update:status": "node scripts/update-helper.mjs status",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:status": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1 -Status",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1",
    "verify:hook": "node scripts/verify-global-hook.mjs",
    "doctor:discord": "node scripts/discord-doctor.mjs",
    "verify:workbuddy": "node scripts/verify-workbuddy.mjs",
    "verify:opencode-go": "node scripts/opencode-go-e2e.mjs",
    "verify:claude-opencode-chat": "node scripts/claude-opencode-chat-e2e.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "https-proxy-agent": "^9.1.0",
    "undici": "^6.28.1",
    "ws": "^8.21.3"
  }
}
